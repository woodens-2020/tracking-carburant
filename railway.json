{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "preDeployCommand": "cd backend && /opt/venv/bin/python migrer_ajout_volontaire.py && /opt/venv/bin/python migrer_utilisateur_roles.py && /opt/venv/bin/python classer_produits_sans_lieu.py",
    "startCommand": "cd backend && /opt/venv/bin/uvicorn main:app --host 0.0.0.0 --port $PORT --proxy-headers --forwarded-allow-ips=*",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
